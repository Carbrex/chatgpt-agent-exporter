{
  "manifest_version": 3,
  "name": "ChatGPT to Agent JSONL Exporter",
  "version": "1.0.1",
  "description": "Export rich ChatGPT conversations as agent-ready JSONL with prompts, thoughts, tool calls, and execution outputs.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Export ChatGPT Conversation",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "permissions": [
    "activeTab",
    "scripting"
  ]
}
